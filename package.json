{
  "name": "formora",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Formora forms and shared workspaces by Tolbert Innovation Hub",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test tests/*.test.js",
